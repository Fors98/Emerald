# Copy to application-local.properties (git-ignored) and run with:
#   mvn spring-boot:run -Dspring-boot.run.profiles=local
# LOCAL DEVELOPMENT ONLY. Never use these relaxed settings in production.
emerald.auth.require-https=false
emerald.auth.refresh.cookie-secure=false
# Origin(s) the admin page is served from (scheme://host:port, no trailing path)
emerald.auth.allowed-origins=http://localhost:8080,http://localhost:5500
# Still provide the secret via the environment, e.g.:
#   export EMERALD_AUTH_JWT_SECRET="$(openssl rand -base64 48)"
# First start only (creates the first admin, then unset them):
#   export EMERALD_AUTH_BOOTSTRAP_EMAIL=you@example.com
#   export EMERALD_AUTH_BOOTSTRAP_PASSWORD='a-long-passphrase-of-14+chars'
